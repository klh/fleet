#!/usr/bin/env bun
// Local post-commit contract check. Git cannot roll back a committed change;
// pre-push repeats the same gate and refuses to publish a regression.
import { resolve } from "node:path";
// W1187: the strip is the incident mitigation (9b98d661) — one shared
// implementation with the fixture-isolation lib, never a second copy
import { stripGitEnv } from "../packages/suspenders/hooks/lib/fixture-isolation.ts";

const root = Bun.spawnSync(["git", "rev-parse", "--show-toplevel"], {
	stdout: "pipe",
}).stdout.toString().trim();
const suite = [
	"help-no-store.test.ts",
	"verb-surface.test.ts",
	"verb-kit.test.ts",
	"coord-addressing.test.ts",
	"consult-kb.test.ts",
	"subscribe-attach.test.ts",
	"subscribe-liveness.test.ts",
	"ws-subscribe.test.ts",
	"kev-curation.test.ts",
	"coord-fact-cas.test.ts",
	"coord-capsule-project-scope.test.ts",
];
if (process.argv.includes("--full"))
	suite.push(
		"work-cli.test.ts",
		// W1216 decomposition: the three completion siblings ride the full
		// push gate too (B1-W1216-fullgate-coverage) — all 4 suites, 30 tests.
		"work-completion-record.test.ts",
		"completion-native-transcript.test.ts",
		"work-completion-claim-context.test.ts",
		"work-completion-cross-repo.test.ts",
		"work-completion-split-context.test.ts",
	);
const tests = suite.map((name) =>
	resolve(root, "packages/suspenders/test", name),
);
const testEnv = { ...stripGitEnv(process.env) };
// 83580 (owner ruling 2026-10-27): spawn-heavy suites sit at 5002-5182ms
// under sustained lane load against bun 5s per-test default - healthy
// pushes refused for hours. 15s default; SUSPENDERS_GATE_TIMEOUT_MS overrides.
const gateTimeout = String(Number(process.env.SUSPENDERS_GATE_TIMEOUT_MS ?? 15_000));
const run = Bun.spawnSync(
	[process.execPath, "test", "--timeout", gateTimeout, ...tests],
	{ cwd: root, env: testEnv, stdout: "inherit", stderr: "inherit" },
);
if (run.exitCode !== 0) {
	console.error("Fleet verb contract failed after commit; repair before pushing.");
	process.exit(run.exitCode || 1);
}
