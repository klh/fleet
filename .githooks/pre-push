#!/bin/sh
# scrub gate (W236) — pre-push leg of hooks/bin/scrub-gate.ts (stdin ref
# lines scanned as the upstream range; falls back to the staged check).
# Enable on this machine: git config core.hooksPath .githooks
command -v bun >/dev/null 2>&1 || exit 0
FLEET_ROOT="$(git rev-parse --show-toplevel)"
bun "$FLEET_ROOT/.githooks/post-commit" --full || exit 1
# W1303.4 schema-first: the committed buckle OpenAPI must match the wire
# schemas (fail only when the tool exists in this repo).
if [ -f "$FLEET_ROOT/packages/buckle/bin/gen-openapi.ts" ]; then
  bun "$FLEET_ROOT/packages/buckle/bin/gen-openapi.ts" --check || exit 1
fi
# W1759: an invalid workflow file cannot land — actionlint when installed
# (CI enforces it unconditionally via the workflow-lint job).
if command -v actionlint >/dev/null 2>&1; then
  actionlint "$FLEET_ROOT"/.github/workflows/*.yml || exit 1
fi
# W1303.1.5 P1 completion: the three P1 guards (versions/deps/pack) ride the
# push gate; findings must be absent or pinned (shrink-only
# tests/helpers/p1-findings.pin.ts).
if [ -f "$FLEET_ROOT/scripts/check-p1.ts" ]; then
  bun "$FLEET_ROOT/scripts/check-p1.ts" gate || exit 1
fi
P="${SUSPENDERS_PREFIX:-$HOME/.claude/hooks/suspenders}"
[ -f "$P/hooks/bin/scrub-gate.ts" ] || P="$(git rev-parse --show-toplevel)/packages/suspenders"
[ -f "$P/hooks/bin/scrub-gate.ts" ] || exit 0
exec bun "$P/hooks/bin/scrub-gate.ts" hook push
