{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"$schema": {
			"description": "JSON Schema pointer for editors (settings.schema.json)",
			"type": "string"
		},
		"version": {
			"description": "THE stack version: one string pins buckle+suspenders+belt",
			"type": "string",
			"minLength": 1,
			"maxLength": 4096
		},
		"updates": {
			"description": "Release reconciliation",
			"type": "object",
			"properties": {
				"mode": {
					"default": "manual",
					"type": "string",
					"enum": ["manual", "latest"]
				},
				"origin": {
					"description": "Release origin",
					"type": "string",
					"minLength": 1,
					"maxLength": 4096
				},
				"check_interval_s": {
					"type": "integer",
					"minimum": 60,
					"maximum": 86400
				}
			},
			"additionalProperties": false
		},
		"auth": {
			"description": "Auth posture",
			"type": "object",
			"properties": {
				"required": {
					"type": "boolean"
				},
				"tokens": {
					"type": "object",
					"properties": {
						"ttlHours": {
							"type": "number",
							"minimum": 0,
							"maximum": 8760
						}
					},
					"additionalProperties": false
				},
				"oidc": {
					"type": "object",
					"properties": {
						"enforced": {
							"type": "boolean"
						},
						"issuer": {
							"description": "OIDC issuer",
							"type": "string",
							"minLength": 1,
							"maxLength": 4096
						},
						"jwksUri": {
							"description": "JWKS URI",
							"type": "string",
							"minLength": 1,
							"maxLength": 4096
						},
						"audience": {
							"description": "Audience",
							"type": "string",
							"minLength": 1,
							"maxLength": 4096
						},
						"requiredScope": {
							"description": "Required scope",
							"type": "string",
							"minLength": 1,
							"maxLength": 4096
						}
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": false
		},
		"providers": {
			"default": {},
			"description": "Where upstream keys live (names/paths only)",
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"env": {
						"description": "Env NAME carrying the key",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					},
					"key_file": {
						"description": "0600 dotenv file PATH holding the key",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					},
					"key_name": {
						"description": "Variable name inside key_file",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					},
					"base_url": {
						"description": "Provider base URL",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					}
				},
				"additionalProperties": false
			}
		},
		"executors": {
			"default": {},
			"description": "Per-executor gateway bases + model pin",
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"anthropic_base": {
						"description": "Anthropic-wire gateway base",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					},
					"openai_base": {
						"description": "OpenAI-wire gateway base",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					},
					"model": {
						"description": "Model pin",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					}
				},
				"additionalProperties": false
			}
		},
		"policies": {
			"default": {},
			"description": "Per-repo routing policy",
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"must": {
						"description": "must law expression",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					},
					"prefer": {
						"description": "prefer law expression",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					},
					"hub": {
						"description": "Hub label",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					},
					"residency": {
						"type": "array",
						"items": {
							"type": "string"
						}
					}
				},
				"additionalProperties": false
			}
		},
		"postures": {
			"description": "Posture document (validated by its owner)",
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {}
		},
		"cache_unsupported_models": {
			"default": [],
			"description": "Models without provider prompt-cache reporting",
			"maxItems": 256,
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 4096
			}
		},
		"hubs": {
			"default": {},
			"description": "Hubs keyed by .prefer label",
			"type": "object",
			"propertyNames": {
				"type": "string",
				"minLength": 1,
				"maxLength": 64,
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"host": {
						"description": "Hub host (ssh user@ stripped for routing)",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					},
					"display_name": {
						"description": "Human-facing label",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					},
					"console_url": {
						"description": "Browser-facing console URL",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					},
					"role": {
						"description": "This machine's relation to the hub",
						"type": "string",
						"enum": ["local", "remote", "peer"]
					},
					"candidates": {
						"description": "Candidate front URLs resolveHub walks (hubs.json)",
						"maxItems": 256,
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1,
							"maxLength": 4096
						}
					},
					"url": {
						"description": "The buckle front URL this hub serves",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					},
					"token_file": {
						"description": "PATH of a 0600 file holding the hub front token",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					},
					"version_override": {
						"description": "Reviewed canary ref for this hub only",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					},
					"ports": {
						"type": "object",
						"properties": {
							"buckle": {
								"description": "Buckle gateway port",
								"type": "integer",
								"minimum": 1,
								"maximum": 65535
							},
							"board": {
								"description": "Fleet board port",
								"type": "integer",
								"minimum": 1,
								"maximum": 65535
							},
							"store": {
								"description": "Store-server port",
								"type": "integer",
								"minimum": 1,
								"maximum": 65535
							},
							"belt": {
								"description": "Belt router port",
								"type": "integer",
								"minimum": 1,
								"maximum": 65535
							},
							"model_store": {
								"description": "Hub model store port",
								"type": "integer",
								"minimum": 1,
								"maximum": 65535
							},
							"buckle_ready": {
								"description": "buckle-ready synthetic readiness port",
								"type": "integer",
								"minimum": 1,
								"maximum": 65535
							}
						},
						"additionalProperties": false,
						"description": "Service ports this hub serves"
					},
					"health_ports": {
						"type": "object",
						"properties": {
							"buckle": {
								"description": "buckle-health sidecar port",
								"type": "integer",
								"minimum": 1,
								"maximum": 65535
							},
							"board": {
								"description": "board-health sidecar port",
								"type": "integer",
								"minimum": 1,
								"maximum": 65535
							},
							"store": {
								"description": "store-health sidecar port",
								"type": "integer",
								"minimum": 1,
								"maximum": 65535
							},
							"belt": {
								"description": "belt-health sidecar port",
								"type": "integer",
								"minimum": 1,
								"maximum": 65535
							},
							"model_store": {
								"description": "model-store health sidecar port",
								"type": "integer",
								"minimum": 1,
								"maximum": 65535
							}
						},
						"additionalProperties": false,
						"description": "Outside-process health sidecar ports"
					},
					"binds": {
						"type": "object",
						"properties": {
							"buckle": {
								"description": "Buckle bind address",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							},
							"board": {
								"description": "Board bind address",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							},
							"belt": {
								"description": "Belt bind address",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							}
						},
						"additionalProperties": false,
						"description": "Bind addresses"
					},
					"allowed_hosts": {
						"description": "Host header allowlist",
						"maxItems": 256,
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1,
							"maxLength": 4096
						}
					},
					"peers": {
						"description": "Peer hub labels",
						"maxItems": 256,
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1,
							"maxLength": 4096
						}
					},
					"services_json": {
						"description": "Services manifest override",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					},
					"quiet_hours": {
						"description": "Nightly dark window HH:MM-HH:MM (routing skips)",
						"type": "string",
						"pattern": "^\\d{1,2}:\\d{2}-\\d{1,2}:\\d{2}$"
					},
					"knowledge": {
						"type": "object",
						"properties": {
							"port": {
								"description": "Knowledge sink port",
								"type": "integer",
								"minimum": 1,
								"maximum": 65535
							},
							"health_port": {
								"description": "Sink health",
								"type": "integer",
								"minimum": 1,
								"maximum": 65535
							}
						},
						"additionalProperties": false
					},
					"ready_model": {
						"description": "Model the readiness leg asks",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					},
					"buckle_entry": {
						"description": "Buckle entrypoint override",
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					},
					"http_upstream_hosts": {
						"description": "Private hosts reachable over plain http",
						"maxItems": 256,
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1,
							"maxLength": 4096
						}
					},
					"provider_intents": {
						"description": "Display-only provider placements",
						"maxItems": 256,
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1,
							"maxLength": 4096
						}
					},
					"provider_requirements": {
						"description": "Central provider profiles this hub requires",
						"maxItems": 256,
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1,
							"maxLength": 4096
						}
					},
					"deploy": {
						"type": "object",
						"properties": {
							"ssh": {
								"description": "ssh target (user@host)",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							},
							"dir": {
								"type": "string",
								"minLength": 1,
								"description": "Deploy dir on the hub device"
							},
							"docker": {
								"description": "docker binary path on the hub",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							},
							"compose": {
								"description": "compose invocation override",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							},
							"connect_timeout": {
								"type": "integer",
								"minimum": 1,
								"maximum": 600
							}
						},
						"required": ["dir"],
						"additionalProperties": false,
						"description": "Deploy target (git-pulled volumes, never host paths)"
					},
					"repos": {
						"type": "object",
						"properties": {
							"ref": {
								"description": "Git ref pin",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							},
							"buckle": {
								"description": "buckle origin override",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							},
							"suspenders": {
								"description": "suspenders origin override",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							},
							"belt": {
								"description": "belt origin override",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							},
							"src": {
								"description": "Packages root inside the clone",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							}
						},
						"additionalProperties": false
					},
					"secrets": {
						"type": "object",
						"properties": {
							"buckle_root_key": {
								"description": "PATH of the 0600 buckle root key on the hub",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							},
							"buckle_service_key": {
								"description": "PATH of the 0600 buckle service key",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							},
							"buckle_service_key_env": {
								"description": "Env NAME carrying the service key",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							},
							"upstream_keys": {
								"description": "Upstream key env NAME → 0600 file PATH",
								"type": "object",
								"propertyNames": {
									"type": "string"
								},
								"additionalProperties": {
									"type": "string"
								}
							}
						},
						"additionalProperties": false,
						"description": "Secret PATHS on the owning device — values never live here"
					},
					"belt_model": {
						"description": "Belt-owned OpenAI model wire",
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {}
					},
					"route_preflight": {
						"description": "Route preflight terminal origins",
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {}
					},
					"mdns": {
						"description": "mDNS announcer knobs",
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {}
					},
					"overlay": {
						"description": "Overlay code-loader knobs",
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {}
					},
					"trace_tunnel": {
						"description": "Trace tunnel front",
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {}
					},
					"upstreams": {
						"description": "The hub's real upstream ladder",
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {}
					},
					"buckle_prefs": {
						"description": "Routing-decision gates",
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {}
					},
					"metrics": {
						"description": "Native metrics connector",
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {}
					},
					"buckle_gateway": {
						"description": "Per-hub buckle gateway policy overrides",
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {}
					},
					"settings": {
						"description": "Deep-partial SettingsSchema overlay for this hub's own install (validated after merge)",
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {}
					}
				},
				"additionalProperties": false
			}
		},
		"fleet_loop": {
			"description": "The hub supervisor loop: lane caps, cadence, registered repos",
			"default": {},
			"type": "object",
			"properties": {
				"lane_target": {
					"default": 6,
					"description": "Global live-lane ceiling across every registered repo",
					"type": "integer",
					"minimum": 1,
					"maximum": 200
				},
				"dispatch_target": {
					"default": 8,
					"description": "Dispatch refill target per cycle",
					"type": "integer",
					"minimum": 1,
					"maximum": 200
				},
				"every_s": {
					"default": 120,
					"description": "Fleet-loop cycle cadence (seconds)",
					"type": "integer",
					"minimum": 10,
					"maximum": 3600
				},
				"config_poll_s": {
					"default": 10,
					"description": "Config re-read interval (seconds)",
					"type": "integer",
					"minimum": 1,
					"maximum": 600
				},
				"maintenance": {
					"default": true,
					"description": "Run the maintenance task set each cycle",
					"type": "boolean"
				},
				"merge_stuck_hours": {
					"default": 6,
					"description": "Merge-ladder stuck alarm age (hours)",
					"type": "integer",
					"minimum": 1,
					"maximum": 168
				},
				"projects": {
					"default": [],
					"description": "Registered repos (empty = the --repo arg only)",
					"maxItems": 64,
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"path": {
								"type": "string",
								"minLength": 1,
								"description": "Repo checkout path (~/ expands)"
							},
							"glob": {
								"description": "Branch glob the merge ladder considers",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							},
							"ladder": {
								"description": "Merge ladder name for this repo",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							},
							"dispatch_cmd": {
								"description": "Dispatch command override for this repo",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							},
							"main": {
								"description": "Main branch name (default: the repo's HEAD branch)",
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							},
							"lane_target": {
								"description": "Per-repo lane sub-cap under fleet_loop.lane_target",
								"type": "integer",
								"minimum": 0,
								"maximum": 200
							},
							"enabled": {
								"default": true,
								"description": "Supervise this repo",
								"type": "boolean"
							}
						},
						"required": ["path"],
						"additionalProperties": false
					}
				}
			},
			"additionalProperties": false
		},
		"consult": {
			"description": "Consult routing, interrupts and feedback",
			"default": {},
			"type": "object",
			"properties": {
				"feedback": {
					"description": "Knowledge-answer feedback obligation",
					"default": {},
					"type": "object",
					"properties": {
						"require_on_done": {
							"default": false,
							"description": "Block `work done` while a knowledge answer this lane received is unreported",
							"type": "boolean"
						}
					},
					"additionalProperties": false
				},
				"interrupt": {
					"description": "High-priority direct consults delivered as steers",
					"default": {},
					"type": "object",
					"properties": {
						"min_interval_s": {
							"default": 180,
							"description": "Min seconds between interrupts (steers) per recipient",
							"type": "integer",
							"minimum": 120,
							"maximum": 300
						},
						"per_sender_min_interval_s": {
							"default": 180,
							"description": "Min seconds between interrupts per sender",
							"type": "integer",
							"minimum": 120,
							"maximum": 300
						}
					},
					"additionalProperties": false
				},
				"oracle": {
					"description": "Oracle pre-check before consult delivery",
					"default": {},
					"type": "object",
					"properties": {
						"min_trust": {
							"default": "candidate",
							"description": "Lowest knowledge state the oracle may answer from (candidate answers are marked unreviewed)",
							"type": "string",
							"enum": ["candidate", "active"]
						}
					},
					"additionalProperties": false
				},
				"spawn_timeout_ms": {
					"default": 30000,
					"description": "Board consult spawn timeout (ms)",
					"type": "integer",
					"minimum": 1000,
					"maximum": 600000
				},
				"max_concurrent": {
					"default": 2,
					"description": "Concurrent board consult spawns",
					"type": "integer",
					"minimum": 1,
					"maximum": 64
				},
				"federation_file": {
					"description": "Consult federation peers file",
					"type": "string",
					"minLength": 1,
					"maxLength": 4096
				}
			},
			"additionalProperties": false
		},
