	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.2",
	"engines": {
		"bun": "1.4.2"
	},
	"devDependencies": {
		"@klh/test-kit": "2.0.0"
	},
	"license": "SEE LICENSE IN LICENSE",
	"exports": {
		"./*": "./*",
		"./package.json": "./package.json"
	},
