{
	"_comment": "suspenders hook wiring — merge the 'hooks' object into ~/.claude/settings.json (install.sh --wire does this safely). Paths assume the default prefix ~/.claude/hooks/suspenders. Every registration is `bun gate.ts <event>` — one entrypoint, dispatch in gate.ts.",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/session-start.ts"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/gate.ts claude-wake",
						"asyncRewake": true,
						"timeout": 86400
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/session-end.ts",
						"async": true
					}
				]
			}
		],
		"PreToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/gate.ts push",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/gate.ts pre-bash",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "Edit|Write|NotebookEdit|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/gate.ts governor",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "Edit|Write|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/gate.ts pre-files",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "Read",
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/gate.ts pre-read",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "Skill",
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/gate.ts pre-skill",
						"timeout": 10
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/gate.ts post-files",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "Bash|Edit|Write|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/gate.ts post-fail",
						"timeout": 10
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/gate.ts push",
						"timeout": 10
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/gate.ts claude-wake",
						"asyncRewake": true,
						"timeout": 86400
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/gate.ts stop"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/gate.ts claude-wake",
						"asyncRewake": true,
						"timeout": 86400
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/gate.ts ask",
						"timeout": 15
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/gate.ts claude-wake",
						"asyncRewake": true,
						"timeout": 86400
					}
				]
			}
		],
		"PreCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/gate.ts precompact"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun $HOME/.claude/hooks/suspenders/pre-compact.ts"
					}
				]
			}
		]
	},
	"statusLine": {
		"type": "command",
		"command": "bun $HOME/.claude/hooks/suspenders/statusline.ts"
	},
	"subagentStatusLine": {
		"type": "command",
		"command": "bun $HOME/.claude/hooks/suspenders/subagent-statusline.ts"
	}
}
