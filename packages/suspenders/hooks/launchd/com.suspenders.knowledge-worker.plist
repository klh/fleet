<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.suspenders.knowledge-worker</string>
  <key>ProgramArguments</key><array>
    <string>__BUN__</string>
    <string>__PREFIX__/bin/knowledge-worker.ts</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <!-- Knowledge distillation enters Buckle with a scoped key from a mode-0600
       machine-local knowledge-buckle.json (or explicit environment pair).
       The W96 hint keeps local specialist routing. -->
  <key>EnvironmentVariables</key><dict>
    <!-- W103 substitution contract: repo root for the mechanical single-file
         test (pointer-row conversion / reject on ingest) -->
    <key>KNOWLEDGE_DOCS_ROOT</key><string>__REPO__</string>
  </dict>
  <key>StandardOutPath</key><string>/tmp/suspenders-knowledge-worker.log</string>
  <key>StandardErrorPath</key><string>/tmp/suspenders-knowledge-worker.log</string>
</dict></plist>
