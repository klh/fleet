<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- W1256.1: the daily analyst runs, migrated from speedy's hand-installed
       com.klh.claude-insights plist. Field-parity twin of the claude-insights
       services.yaml entry; the old label rides legacyLabels boot-out. -->
  <key>Label</key><string>com.suspenders.claude-insights</string>
  <key>ProgramArguments</key><array><string>__BUN__</string><string>__HOME__/.claude/local-llm/daily-insights.ts</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>43</integer></dict>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>__HOME__</string><key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StandardOutPath</key><string>__HOME__/.claude-insights/launchd-stdout.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.claude-insights/launchd-stdout.log</string>
</dict></plist>
