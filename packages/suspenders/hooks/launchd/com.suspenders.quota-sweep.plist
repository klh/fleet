<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- W366: quota-exhaustion pickup — every 15 min (== the lane-log staleness
     floor), report lines land in /tmp/quota-sweep.log. Runs the CLI with
     --act: dead sid + terminal quota signature → work reclaim + coord emit
     + broadcast; live lanes are never touched. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.suspenders.quota-sweep</string>
  <key>ProgramArguments</key><array>
    <string>__BUN__</string>
    <string>__PREFIX__/bin/quota-sweep.ts</string>
    <string>--act</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/quota-sweep.log</string>
  <key>StandardErrorPath</key><string>/tmp/quota-sweep.log</string>
</dict></plist>
