<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.suspenders.cloud-gateway</string>
  <key>ProgramArguments</key><array><string>__BUN__</string><string>__PREFIX__/.harness/packages/belt/bin/cloud-gateway.ts</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>__HOME__</string><key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StandardOutPath</key><string>__HOME__/.claude-insights/cloud-gateway.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.claude-insights/cloud-gateway.log</string>
</dict></plist>
