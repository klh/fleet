<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
	<key>Label</key>
	<string>com.belt.swarm</string>
	<key>ProgramArguments</key>
	<array>
		<string>__BUN__</string>
		<string>__HOME__/.claude/local-llm/swarm.ts</string>
		<string>supervise</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>BELT_WIRED_GUARD_GB</key>
		<string>90</string>
		<key>PATH</key>
		<string>__HOME__/.local/bin:__HOME__/.local/share/uv/tools/mlx-lm/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/.claude-insights/mlx-swarm.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.claude-insights/mlx-swarm.log</string>
</dict></plist>
