<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.suspenders.local-bar</string>
  <key>ProgramArguments</key><array><string>__BUN__</string><string>__PREFIX__/bin/launchd-launcher.ts</string><string>local-bar</string><string>--</string><string>__HOME__/.local/klh-local/bin/dashboard.ts</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/.local/state/klh-local/dashboard.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/state/klh-local/dashboard.log</string>
</dict></plist>
