<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
	<key>Label</key>
	<string>com.suspenders.local-llm</string>
	<key>ProgramArguments</key>
	<array>
		<string>__BUN__</string>
		<string>__HOME__/.claude/local-llm/swarm.ts</string>
		<string>serve</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>BELT_TIER</key>
		<string>full</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/.claude-insights/swarm-serve-launchd.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.claude-insights/swarm-serve-launchd.log</string>
</dict></plist>
