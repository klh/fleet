<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
	<key>Label</key>
	<string>com.suspenders.belt-swarm</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>unset BELT_ESCALATE_URL BELT_ESCALATE_KEY BELT_ESCALATE_MODEL; set -ae; . "$1"; shift; exec "$@"</string>
		<string>fleet-belt-swarm</string>
		<string>__HOME__/.claude/local-llm/belt.env</string>
		<string>__BUN__</string>
		<string>__HOME__/.claude/local-llm/swarm.ts</string>
		<string>supervise</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__HOME__/.local/bin:__HOME__/.local/share/uv/tools/mlx-lm/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/.claude-insights/mlx-swarm.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.claude-insights/mlx-swarm.log</string>
</dict></plist>
