<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.suspenders.board</string>
  <key>ProgramArguments</key><array>
    <string>__BUN__</string>
    <string>__PREFIX__/bin/fleet-board.ts</string>
  </array>
  <!-- W264: loopback default (no bind override here); the LAN reaches the
       board through the Caddy front (suspenders.local). Opt in explicitly. -->
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>__HOME__/.local/bin:__HOME__/.claude/local:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- 2026-10-12: in-process SQLite — the store.url HTTP transport costs
         one curl spawn PER statement and payload() stacks hundreds, wedging
         the event loop 10-20s per request until every .local face starves. -->
    <key>GOVERNOR_STORE_URL</key><string>local</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.claude-insights/fleet-board.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.claude-insights/fleet-board.log</string>
</dict></plist>
