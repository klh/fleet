<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.suspenders.lane-guard</string>
  <key>ProgramArguments</key><array>
    <string>__BUN__</string>
    <string>__PREFIX__/bin/lane-guard.ts</string>
    <string>--repo</string>
    <string>__REPO__</string>
  </array>
  <!-- W1141 lane guard — resident push+egress proxies. INERT by posture: the
       push front answers 401 without a minted identity, the egress front
       starts only when the machine conf (~/.claude/lane-guard.json) carries
       an egress.allow list; absent conf = nothing wired, nothing denied. -->
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>__HOME__/.local/bin:__HOME__/.claude/local:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.claude-insights/lane-guard.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.claude-insights/lane-guard.log</string>
</dict></plist>
