{
	"name": "@klh/suspenders",
	"version": "2.3.1",
	"description": "A control plane for agent fleets — SQLite state, capability-aware dispatch, zombie detection, decisions with LLM recommendations, a consult knowledge base, and a live fleet board",
	"type": "module",
	"license": "SEE LICENSE IN LICENSE",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"test": "bun test test/",
		"test:unit": "bun --bun playwright test --config test/playwright.config.ts --project unit",
		"ci": "bun install && bun test test/",
		"build:styles": "bun scripts/build-styles.ts",
		"build:vendor": "bun scripts/build-vendor.ts",
		"test:e2e": "bunx --bun playwright test --config e2e/playwright.config.ts"
	},
	"dependencies": {
		"@clack/prompts": "1.8.1",
		"@earendil-works/chord": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-durable": "1.5.0",
		"@klh/belt": "2.3.1",
		"@klh/blam": "2.3.1",
		"@klh/buckle": "2.3.1",
		"@klh/design-ui": "2.3.1",
		"@klh/kernel": "2.3.1",
		"@klh/local-llm": "2.3.1",
		"@klh/settings": "2.3.1",
		"@klh/speedy": "2.3.1",
		"@klh/telemetry": "2.3.1",
		"@vercel/detect-agent": "1.2.7",
		"cli-table3": "0.6.5",
		"execa": "10.2.1",
		"lit": "3.3.3",
		"meow": "14.1.0",
		"ora": "9.4.1",
		"p-queue": "9.3.5",
		"picocolors": "1.1.1",
		"shell-quote": "1.12.0",
		"ts-morph": "28.0.0",
		"xdg-basedir": "5.1.0",
		"zod": "4.6.7",
		"@earendil-works/pi-tui": "1.5.0",
		"typebox": "1.3.27"
	},
	"engines": {
		"bun": "1.4.2"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@klh/test-kit": "2.3.1",
		"@playwright/test": "1.64.1",
		"acorn": "8.19.0",
		"chromium-bidi": "12.1.0",
		"yaml": "2.9.1"
	},
	"exports": {
		"./hooks/*": "./hooks/*",
		"./scripts/*": "./scripts/*",
		"./deploy/*": "./deploy/*",
		"./agent-rules/*": "./agent-rules/*",
		"./package.json": "./package.json"
	},
	"files": [
		"hooks",
		"scripts",
		"deploy",
		"agent-rules",
		"pi-extensions",
		"install.sh",
		"settings.example.json",
		"README.md",
		"LICENSE",
		"NOTICE",
		"ECOSYSTEM.md",
		"AGENTS.md",
		"CLAUDE.md",
		"!**/*.test.ts",
		"!**/*.e2e.ts",
		"!**/*.fixtures.ts",
		"!**/playwright.config.ts"
	],
	"bin": {
		"coord": "hooks/bin/coord.ts",
		"work": "hooks/bin/work.ts",
		"dispatch": "scripts/dispatch-next.ts",
		"fleet-tracker": "hooks/bin/fleet-tracker.ts",
		"oracle": "hooks/bin/oracle.ts",
		"copilot": "hooks/bin/copilot.ts"
	}
}
