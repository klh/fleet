{
	"name": "@klh/suspenders",
	"version": "2.0.0",
	"description": "A control plane for agent fleets — SQLite state, capability-aware dispatch, zombie detection, decisions with LLM recommendations, a consult knowledge base, and a live fleet board",
	"type": "module",
	"workspaces": [
		"*"
	],
	"license": "SEE LICENSE IN LICENSE",
	"scripts": {
		"test": "bun test test/",
		"test:e2e": "playwright test --config e2e/playwright.config.ts",
		"ci": "bun install && bun test test/",
		"build:vendor": "bun scripts/build-vendor.ts"
	},
	"dependencies": {
		"@clack/prompts": "1.8.1",
		"@klh/blam": "2.0.0",
		"@klh/buckle": "2.0.0",
		"cli-table3": "0.6.5",
		"execa": "10.2.1",
		"lit": "3.3.3",
		"meow": "14.1.0",
		"ora": "9.4.1",
		"p-queue": "9.3.5",
		"picocolors": "1.1.1",
		"shell-quote": "1.12.0",
		"ts-morph": "28.0.0",
		"xdg-basedir": "5.1.0",
		"zod": "4.6.7"
	},
	"engines": {
		"bun": "1.4.2"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"acorn": "8.19.0",
		"chromium-bidi": "12.1.0"
	},
	"exports": {
		"./hooks/*": "./hooks/*",
		"./scripts/*": "./scripts/*",
		"./deploy/*": "./deploy/*",
		"./agent-rules/*": "./agent-rules/*",
		"./package.json": "./package.json"
	},
	"files": [
		"hooks",
		"scripts",
		"deploy",
		"agent-rules",
		"install.sh",
		"settings.example.json",
		"README.md",
		"LICENSE",
		"NOTICE",
		"ECOSYSTEM.md",
		"AGENTS.md",
		"CLAUDE.md"
	],
	"bin": {
		"coord": "hooks/bin/coord.ts",
		"work": "hooks/bin/work.ts",
		"dispatch": "scripts/dispatch-next.ts",
		"fleet-tracker": "hooks/bin/fleet-tracker.ts",
		"oracle": "hooks/bin/oracle.ts",
		"copilot": "hooks/bin/copilot.ts"
	}
}
