{
	"log": { "level": "info", "output": "<SINGBOX_LOG_FILE>", "timestamp": true },
	"dns": {
		"servers": [
			{ "type": "local", "tag": "dns-local" },
			{ "type": "udp", "tag": "dns-upstream", "server": "1.1.1.1" }
		],
		"rules": [{ "outbound": "any", "server": "dns-local" }],
		"final": "dns-local"
	},
	"inbounds": [
		{
			"type": "tun",
			"tag": "tun-in",
			"address": ["198.18.0.1/30"],
			"auto_route": true,
			"strict_route": true
		}
	],
	"outbounds": [
		{
			"type": "http",
			"tag": "hub-relay",
			"server": "<HUB_RELAY_HOST>",
			"server_port": "<HUB_RELAY_PORT>"
		},
		{ "type": "direct", "tag": "direct" },
		{ "type": "block", "tag": "block" }
	],
	"route": {
		"rules": [
			{ "protocol": "dns", "action": "hijack-dns" },
			{
				"process_path_regex": "^/Applications/Claude\\.app/",
				"outbound": "hub-relay"
			},
			{
				"process_path_regex": "^/Applications/ChatGPT\\.app/",
				"outbound": "hub-relay"
			},
			{ "ip_is_private": true, "outbound": "direct" }
		],
		"final": "direct",
		"auto_detect_interface": true
	},
	"experimental": {
		"clash_api": {
			"external_controller": "127.0.0.1:<CLASH_API_PORT>",
			"secret": "<CLASH_API_SECRET>"
		}
	}
}
