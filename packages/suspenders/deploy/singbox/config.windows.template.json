			"auto_route": true,
			"strict_route": true
		}
	],
	"outbounds": [
		{
			"tag": "hub-relay",
			"type": "http",
			"server": "<HUB_RELAY_HOST>",
			"server_port": "<HUB_RELAY_PORT>"
		},
		{ "tag": "direct", "type": "direct" }
	],
	"route": { "rules": [], "final": "direct", "auto_detect_interface": true },
	"experimental": {
		"clash_api": {
			"external_controller": "127.0.0.1:<CLASH_API_PORT>",
			"secret": "<CLASH_API_SECRET>"
		}
	}
