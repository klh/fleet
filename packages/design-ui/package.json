{
	"name": "@klh/design-ui",
	"version": "2.1.2",
	"description": "Shared UI foundations: design tokens (build face + typed module), typed event kit, SCSS→Lit styles plugin, register pattern, catalog harness",
	"type": "module",
	"license": "SEE LICENSE IN LICENSE",
	"private": true,
	"packageManager": "bun@1.4.2",
	"engines": {
		"bun": "1.4.2"
	},
	"scripts": {
		"build:tokens": "bun src/tokens/build.ts"
	},
	"exports": {
		".": "./src/index.ts",
		"./tokens": "./src/tokens/dist/tokens.css",
		"./tokens.css": "./src/tokens/dist/tokens.css",
		"./themes/*": "./src/tokens/dist/themes/*.css"
	},
	"files": [
		"src",
		"catalog",
		"README.md"
	],
	"dependencies": {
		"lit": "3.3.3",
		"sass": "1.107.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1"
	}
}
