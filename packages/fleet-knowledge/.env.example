# .env.example — every env knob the code reads, grouped by surface.
# Copy to .env and fill in what you need. Values shown are the defaults
# the code applies when a knob is unset. Secrets belong in 0600 files
# where a *_KEY_FILE / *_TOKEN_FILE form exists; prefer files over env.
#
# The SUSPENDERS_ prefix is historical — kept so a fleet install's
# existing environment keeps working unchanged.

# ─── Sink API (bin/knowledge-api.ts) ────────────────────────────────────────
# Port the sink listens on (docker-compose.yml pins 7802).
KNOWLEDGE_API_PORT=7802
# /status auto-refresh seconds for the embedded status page (default 5).
# STATUS_REFRESH_S=5
# Bind address. 127.0.0.1 by default — a LAN or container bind opts in to
# the host allowlist below (DNS-rebind defense; see SECURITY.md).
KNOWLEDGE_API_BIND=127.0.0.1
# Repo root used to hash source_ref evidence and scan docs for the
# substitution test. Defaults to the process working directory.
# KNOWLEDGE_REPO_ROOT=/path/to/repo
# SQLite db root. There is no directory env knob: the REG root is
# $HOME/.cache/claude-governor (src/db.ts). Container deployments pin HOME
# to a mounted volume (docker-compose.yml sets HOME=/data) so knowledge.db
# lands at /data/.cache/claude-governor/knowledge.db.
# Credential this install presents as an anti-entropy PEER (one-shot
# `bun run bin/knowledge-api.ts --ae-pull <peer-url>`), or the token file
# alternative: --ae-token-file <path>.
# SUSPENDERS_AE_PEER_TOKEN=

# ─── Host perimeter (src/host-guard.ts) ─────────────────────────────────────
# Comma-separated *.local hostnames allowed in the Host header, on top of
# loopback. Every request — reads included — is gated (DNS-rebind defense).
SUSPENDERS_ALLOWED_HOSTS=localhost.local
# Per-install write token file (0600, generated on first start). Mutating
# routes require its contents as the x-klh-write-token header.
# SUSPENDERS_WRITE_TOKEN_FILE=/path/to/write-token

# ─── Sink client (src/knowledge-sink-client.ts) ─────────────────────────────
# Where a client finds a sink. Unset = the sink is unconfigured and every
# call fails open locally.
# SUSPENDERS_KNOWLEDGE_SINK_URL=https://sink.example.local
# bksk_ key for the /knowledge/* faces — env form (key-file form preferred).
# SUSPENDERS_KNOWLEDGE_KEY=
# 0600 single-line key file, preferred over the raw env key.
# SUSPENDERS_KNOWLEDGE_KEY_FILE=/path/to/bksk-key
# Recall budget in ms. A slow sink must not stall the caller.
SUSPENDERS_KNOWLEDGE_SINK_TIMEOUT_MS=2000

# ─── Query faces auth backend (the buckle front) ────────────────────────────
# Base of the front whose /v1/admin/keys/verify endpoint validates bksk_
# keys. Unset = http://127.0.0.1:4101.
# SUSPENDERS_KNOWLEDGE_VERIFY_URL=http://127.0.0.1:4101
# Admin-scoped credential for the verify call (BUCKLE_ADMIN_KEY is the
# fallback). Absent = the faces answer 503, fail closed.
# SUSPENDERS_KNOWLEDGE_VERIFY_TOKEN=
# Verify-call budget in ms.
SUSPENDERS_KNOWLEDGE_VERIFY_TIMEOUT_MS=3000
# Face scopes are constants, not env: mint bksk_ keys with
#   buckle:knowledge:QUERY_  → POST /knowledge/query (SINK_QUERY_SCOPE)
#   buckle:knowledge:READ_   → POST /knowledge/sql   (SINK_READ_SCOPE)

# ─── Pinned SQL LLM (the /knowledge/query translator) ───────────────────────
# OpenAI-wire base of the pinned SQL translation model. Absent =
# /knowledge/query answers 503; /knowledge/sql is unaffected.
# SUSPENDERS_SQL_LLM_URL=http://127.0.0.1:4000/v1
# Model id. Default: sql
# SUSPENDERS_SQL_LLM_MODEL=sql
# Bearer key for the translator.
# SUSPENDERS_SQL_LLM_KEY=
# Hard ceiling per translation call in ms.
SUSPENDERS_SQL_LLM_TIMEOUT_MS=20000

# ─── Buckle LLM route (ingest worker distill calls) ─────────────────────────
# The ONE gated LLM boundary: distill calls ride this front. Setting
# INGEST_LLM_URL is rejected outright — it bypasses the audit trail.
# SUSPENDERS_BUCKLE_URL=http://127.0.0.1:4101
# SUSPENDERS_BUCKLE_TOKEN=bksk-your-scoped-proxy-key
# Alternative to the env pair: a 0600 JSON file {url, token}:
#   ~/.claude/local-llm/knowledge-buckle.json

# ─── Ingest budget + embeddings (src/knowledge-inference.ts) ────────────────
# Requests-per-minute admission for distill/embed calls (1–600).
SUSPENDERS_MEMORY_RPM=20
# Concurrent in-flight calls (1–8).
SUSPENDERS_MEMORY_CONCURRENCY=2
# Max tokens per call (128–8192).
SUSPENDERS_MEMORY_MAX_TOKENS=1600
# How long a call may wait for budget before failing (0–120000 ms).
SUSPENDERS_MEMORY_WAIT_MS=30000
# Embedding endpoint (OpenAI wire) and model.
SUSPENDERS_MEMORY_EMBED_URL=http://127.0.0.1:8907/v1/embeddings
SUSPENDERS_MEMORY_EMBED_MODEL=local-embed
# Rows per embedding request (1–128).
SUSPENDERS_MEMORY_EMBED_BATCH=32
# Optional bearer for the embedding endpoint.
# SUSPENDERS_MEMORY_EMBED_TOKEN=

# ─── Distill + store (bin/knowledge-worker.ts) ──────────────────────────────
# Repo root for the substitution test (doc-covered facts become pointers).
# Unset = the mechanical check is off; the prompt layer still applies.
# KNOWLEDGE_DOCS_ROOT=/path/to/repo
# Distill prompt override (config-over-code); its sha256 is the parser
# version recorded against reprocess checkpoints.
# KNOWLEDGE_PROMPT_FILE=/path/to/distill-prompt.md
# Reserved for a remote store adapter. No local effect today.
# KNOWLEDGE_STORE_URL=

# ─── Redaction (src/redact.ts) ──────────────────────────────────────────────
# Overrides the machine-local scrub denylist file (mode 600, never
# committed); the value "0" disables the denylist pass entirely.
# SUSPENDERS_SCRUB_DENYLIST=/path/to/scrub-denylist

# ─── Curation probe (src/kev.ts, src/kev-review.ts) ─────────────────────────
# Base URL of a curation-system endpoint that stands the "kev" curator
# protocol; a per-call timeout in ms overrides the built-in budget.
# SUSPENDERS_KEV_URL=https://curation.example.local
# SUSPENDERS_KEV_CURATION_TIMEOUT_MS=

# ─── Spoke→hub sync state ───────────────────────────────────────────────────
# Relocates the sync cursor (~/.claude-insights/knowledge-sync-state.json).
# SUSPENDERS_KNOWLEDGE_SYNC_STATE=/path/to/state.json
# Relocates the roll-key registry (~/.cache/claude-governor/roll-keys.json,
# 0600 — only sha256 roll-key hashes are stored there).
# SUSPENDERS_ROLL_KEYS_FILE=/path/to/roll-keys.json

# ─── Consult knobs (src/consult-config.ts) ──────────────────────────────────
# Overrides the config path. Default: $HOME/.config/klh/coord.json (zod
# parsed — consult/steer intervals, knowledge.downvote_threshold).
# SUSPENDERS_COORD_CONFIG=/path/to/coord.json

# ─── Oracle (bin/oracle.ts) ─────────────────────────────────────────────────
# Model id pin for the default leg. Unset = the built-in default pin
# ("local-reason"); the cloud leg's model is a code constant.
# ORACLE_ROUTE_MODEL=local-reason
# Both oracle legs ride the ONE gated LLM boundary (src/inference-buckle.ts)
# — they resolve SUSPENDERS_BUCKLE_URL + SUSPENDERS_BUCKLE_TOKEN (or the
# 0600 knowledge-buckle.json file). There are no separate oracle endpoint
# env knobs.

# ─── Decant (vendored token accounting) ─────────────────────────────────────
# No env knob: the decant binary path is config-over-code via
# knowledge-sync.json's `decantBin` key (code default DECANT_DEFAULT_BIN =
# "decant", resolved from PATH). See docs/decant.md.

# ─── Deliberately unsupported ───────────────────────────────────────────────
# INGEST_LLM_URL — rejected at startup: a direct LLM URL bypasses the
# buckle audit trail. Configure SUSPENDERS_BUCKLE_URL/_TOKEN instead.
# INGEST_LLM_MODEL — affects only the direct-use distill adapter the
# production factory refuses to construct; inert in the worker.
