{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"noUncheckedIndexedAccess": false,
		"resolveJsonModule": true
	},
	"include": ["src/**/*", "bin/**/*", "test/**/*"],
	"exclude": ["decant"]
}
