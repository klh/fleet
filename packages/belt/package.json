		"dashboard": "bin/dashboard.ts",
		"distill": "bin/distill.ts",
		"fleet-refresh": "bin/fleet-refresh.ts",
		"kv-prefix": "bin/kv-prefix.ts",
		"kv-ship": "bin/kv-ship.ts",
		"m365-login": "bin/m365/login.ts",
