{
	"name": "@klh/local",
	"version": "2.0.0",
	"private": true,
	"description": "the local service front — Caddy registration, Bonjour/mDNS names, loopback defaults, service registry",
	"type": "module",
	"license": "SEE LICENSE IN LICENSE",
	"packageManager": "bun@1.4.2",
	"engines": {
		"bun": "1.4.2"
	},
	"dependencies": {
		"lit": "3.3.3"
	},
	"scripts": {
		"build:lit": "bun scripts/build-lit.ts"
	},
	"exports": {
		"./bin/*": "./bin/*",
		"./package.json": "./package.json"
	},
	"bin": {
		"klh-local": "bin/klh-local.ts",
		"dashboard": "bin/dashboard.ts"
	},
	"files": [
		"bin",
		"!bin/*.test.ts",
		"scripts",
		"assets",
		"install.sh",
		"README.md",
		"SPEC.md",
		"ECOSYSTEM.md",
		"AGENTS.md",
		"LICENSE"
	]
}
