{
	"name": "@klh/blam",
	"version": "2.0.0",
	"description": "BLAM — Benchmark of LLM Agent Mishaps: a failure taxonomy, labeled dataset, and reproducible benchmark for LLM agent fleets on shared repositories",
	"type": "module",
	"license": "SEE LICENSE IN LICENSE",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"test": "bun test test/",
		"validate": "bun tools/label.ts validate dataset/incidents.jsonl"
	},
	"engines": {
		"bun": "1.4.2"
	},
	"devDependencies": {
		"@klh/belt": "2.0.0",
		"@klh/buckle": "2.0.0",
		"@klh/suspenders": "2.0.0"
	},
	"exports": {
		"./src/*": "./src/*",
		"./test/*": "./test/*",
		"./package.json": "./package.json"
	},
	"bin": {
		"blam-label": "tools/label.ts"
	},
	"files": [
		"src",
		"test/fixtures",
		"tools",
		"dataset",
		"schema",
		"bench",
		"docs",
		"README.md",
		"LICENSE",
		"AGENTS.md"
	]
}
